enclave {
    include "sgx_tcrypto.h"
    include "sgx_report.h"

    trusted {
        /*
         * Exports the enclave's own sgx_target_info_t so a peer can bind
         * an SGX Local Attestation Report specifically to this enclave.
         */
        public sgx_status_t ecall_get_target_info(
            [out] sgx_target_info_t* target_info
        );

        /*
         * Generates an ephemeral NIST P-256 keypair inside EPC memory and binds
         * the 64-byte public key (X || Y) into an SGX Report targeted at the peer.
         */
        public sgx_status_t ecall_generate_attested_key(
            [in] const sgx_target_info_t* p_peer_target_info,
            [out] sgx_report_t* p_report
        );

        /*
         * Verifies the peer's SGX Report MAC (sgx_verify_report), checks MRSIGNER
         * and MRENCLAVE, extracts report_data inside the enclave, and derives
         * the AES-128 session key.
         */
        public sgx_status_t ecall_verify_and_derive(
            [in] const sgx_report_t* p_peer_report
        );

        /*
         * Core P2P AES-GCM Telemetry (single-use ephemeral session key)
         */
        public sgx_status_t ecall_encrypt_payload(
            [in, string] const char* plaintext,
            [out, size=ciphertext_max_len] char* ciphertext_buffer,
            size_t ciphertext_max_len,
            [out] size_t* actual_ciphertext_len
        );

        public sgx_status_t ecall_decrypt_payload(
            [in, size=ciphertext_len] const char* ciphertext_buffer,
            size_t ciphertext_len
        );
    };

    untrusted {
        /* Standard Host logging proxy */
        void ocall_print_string([in, string] const char *str);
    };
};
